# LLM Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative: OpenAI (if using OpenAI instead)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_email_engine
DATABASE_ECHO=false

# Vector Store Configuration (using pgvector in Postgres)
VECTOR_STORE_TYPE=pgvector
EMBEDDING_MODEL=openai
EMBEDDING_DIMENSION=1536

# Email Ingestion (IMAP - mocked in Phase 1)
IMAP_HOST=mock
IMAP_PORT=993
IMAP_EMAIL=test@example.com
IMAP_PASSWORD=mock_password
IMAP_POLL_INTERVAL_SECONDS=300

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENV=development
DEBUG=true
