# LLM Configuration
# LLM_MODEL is the LiteLLM model string used by every agent by default.
# Swap this per environment — cheap model for dev, stronger model for prod.
# Each provider needs its own API key below; only set the ones you use.
LLM_MODEL=deepseek/deepseek-chat

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MOONSHOT_API_KEY=your_moonshot_kimi_api_key_here

# Examples of LLM_MODEL values:
#   deepseek/deepseek-chat     - cheap, good for dev/pipeline testing
#   moonshot/kimi-k2           - cheap, good for dev/pipeline testing
#   claude-sonnet-5            - production quality (Anthropic)
#   claude-opus-5              - highest quality, most expensive (Anthropic)
#   gpt-4o-mini                - cheap OpenAI option

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_email_engine
DATABASE_ECHO=false

# Vector Store Configuration (using pgvector in Postgres)
VECTOR_STORE_TYPE=pgvector
EMBEDDING_MODEL=openai
EMBEDDING_DIMENSION=1536

# Email Ingestion (IMAP - mocked in Phase 1)
IMAP_HOST=mock
IMAP_PORT=993
IMAP_EMAIL=test@example.com
IMAP_PASSWORD=mock_password
IMAP_POLL_INTERVAL_SECONDS=300

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENV=development
DEBUG=true
